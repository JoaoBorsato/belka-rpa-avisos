<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="belka_avisos_def" targetNamespace="https://belka.exemplo.com/rpa" exporter="belka gerar_bpmn.py" exporterVersion="1.0">
<bpmn:process id="belka_avisos" name="Belka RPA · avisos oficiais do INMET" isExecutable="false">
<bpmn:startEvent id="inicio" name="Início agendado (todo dia, 06:45)"><bpmn:outgoing>f0</bpmn:outgoing></bpmn:startEvent>
<bpmn:scriptTask id="t_cfg" name="Carregar e validar configuração"><bpmn:incoming>f0</bpmn:incoming><bpmn:outgoing>f1</bpmn:outgoing></bpmn:scriptTask>
<bpmn:exclusiveGateway id="g_cfg" name="Configuração válida?"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing><bpmn:outgoing>f3</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="t_feed" name="Ler feed RSS do INMET (3 tentativas, espera crescente)"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="g_feed" name="Feed lido?"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing><bpmn:outgoing>f6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="g_base" name="Existe leitura anterior na base?"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing><bpmn:outgoing>f8</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:scriptTask id="t_desat" name="Seguir com a base e marcar fonte desatualizada"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:scriptTask>
<bpmn:scriptTask id="t_item" name="Próximo aviso do feed (para cada item)"><bpmn:incoming>f5</bpmn:incoming><bpmn:incoming>f35</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing><bpmn:standardLoopCharacteristics /></bpmn:scriptTask>
<bpmn:exclusiveGateway id="g_visto" name="Já processado?"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing><bpmn:outgoing>f12</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="t_cap" name="Baixar documento CAP (3 tentativas)"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="g_baixou" name="Baixou?"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing><bpmn:outgoing>f15</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:scriptTask id="t_pend" name="Registrar pendência (refazer na próxima execução)"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing></bpmn:scriptTask>
<bpmn:scriptTask id="t_valida" name="Validar CAP (XML seguro, campos, datas)"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing></bpmn:scriptTask>
<bpmn:exclusiveGateway id="g_valido" name="CAP válido?"><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing><bpmn:outgoing>f19</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:scriptTask id="t_quar" name="Quarentena com o motivo"><bpmn:incoming>f19</bpmn:incoming><bpmn:outgoing>f20</bpmn:outgoing></bpmn:scriptTask>
<bpmn:exclusiveGateway id="g_real" name="Aviso real e inédito? (status Actual, identifier novo)"><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f21</bpmn:outgoing><bpmn:outgoing>f22</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:scriptTask id="t_ign" name="Ignorar e registrar (exercício ou duplicado)"><bpmn:incoming>f22</bpmn:incoming><bpmn:outgoing>f23</bpmn:outgoing></bpmn:scriptTask>
<bpmn:exclusiveGateway id="g_tipo" name="Tipo da mensagem?"><bpmn:incoming>f21</bpmn:incoming><bpmn:outgoing>f24</bpmn:outgoing><bpmn:outgoing>f25</bpmn:outgoing><bpmn:outgoing>f26</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:scriptTask id="t_cancel" name="Marcar aviso citado como cancelado"><bpmn:incoming>f24</bpmn:incoming><bpmn:outgoing>f27</bpmn:outgoing></bpmn:scriptTask>
<bpmn:scriptTask id="t_subst" name="Marcar aviso anterior como substituído"><bpmn:incoming>f25</bpmn:incoming><bpmn:outgoing>f28</bpmn:outgoing></bpmn:scriptTask>
<bpmn:exclusiveGateway id="g_area" name="Atinge município piloto? (código IBGE ou mesorregião)"><bpmn:incoming>f26</bpmn:incoming><bpmn:incoming>f28</bpmn:incoming><bpmn:outgoing>f29</bpmn:outgoing><bpmn:outgoing>f30</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:scriptTask id="t_fora" name="Ignorar: fora da área piloto"><bpmn:incoming>f30</bpmn:incoming><bpmn:outgoing>f31</bpmn:outgoing></bpmn:scriptTask>
<bpmn:scriptTask id="t_nivel" name="Converter severidade em nível Belka e riscos"><bpmn:incoming>f29</bpmn:incoming><bpmn:outgoing>f32</bpmn:outgoing></bpmn:scriptTask>
<bpmn:scriptTask id="t_grava" name="Gravar aviso no banco"><bpmn:incoming>f32</bpmn:incoming><bpmn:outgoing>f33</bpmn:outgoing></bpmn:scriptTask>
<bpmn:exclusiveGateway id="j_item" name=""><bpmn:incoming>f11</bpmn:incoming><bpmn:incoming>f16</bpmn:incoming><bpmn:incoming>f20</bpmn:incoming><bpmn:incoming>f23</bpmn:incoming><bpmn:incoming>f27</bpmn:incoming><bpmn:incoming>f31</bpmn:incoming><bpmn:incoming>f33</bpmn:incoming><bpmn:outgoing>f34</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="g_mais" name="Mais avisos?"><bpmn:incoming>f34</bpmn:incoming><bpmn:outgoing>f35</bpmn:outgoing><bpmn:outgoing>f36</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:scriptTask id="t_comp" name="Comparar com o nível da Belka (belka_mvp.json)"><bpmn:incoming>f9</bpmn:incoming><bpmn:incoming>f36</bpmn:incoming><bpmn:outgoing>f37</bpmn:outgoing></bpmn:scriptTask>
<bpmn:scriptTask id="t_monta" name="Montar avisos_oficiais.json"><bpmn:incoming>f37</bpmn:incoming><bpmn:outgoing>f38</bpmn:outgoing></bpmn:scriptTask>
<bpmn:exclusiveGateway id="g_contr" name="Contrato íntegro?"><bpmn:incoming>f38</bpmn:incoming><bpmn:outgoing>f39</bpmn:outgoing><bpmn:outgoing>f40</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:scriptTask id="t_pub" name="Publicar para o MVP (escrita atômica)"><bpmn:incoming>f39</bpmn:incoming><bpmn:outgoing>f41</bpmn:outgoing></bpmn:scriptTask>
<bpmn:scriptTask id="t_div" name="Exportar divergencias.csv"><bpmn:incoming>f41</bpmn:incoming><bpmn:outgoing>f42</bpmn:outgoing></bpmn:scriptTask>
<bpmn:exclusiveGateway id="g_grave" name="Aviso Grande Perigo ainda não avisado?"><bpmn:incoming>f42</bpmn:incoming><bpmn:outgoing>f43</bpmn:outgoing><bpmn:outgoing>f44</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="t_notif" name="Notificar equipe (webhook)"><bpmn:incoming>f43</bpmn:incoming><bpmn:outgoing>f45</bpmn:outgoing></bpmn:sendTask>
<bpmn:exclusiveGateway id="j_rel" name=""><bpmn:incoming>f44</bpmn:incoming><bpmn:incoming>f45</bpmn:incoming><bpmn:outgoing>f46</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:scriptTask id="t_rel" name="Relatório, log e auditoria"><bpmn:incoming>f46</bpmn:incoming><bpmn:outgoing>f47</bpmn:outgoing></bpmn:scriptTask>
<bpmn:exclusiveGateway id="g_pend" name="Houve pendência?"><bpmn:incoming>f47</bpmn:incoming><bpmn:outgoing>f48</bpmn:outgoing><bpmn:outgoing>f49</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="t_aviso" name="Avisar equipe (webhook)"><bpmn:incoming>f49</bpmn:incoming><bpmn:outgoing>f50</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="fim_ok" name="Sucesso"><bpmn:incoming>f48</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="fim_pend" name="Sucesso com pendências"><bpmn:incoming>f50</bpmn:incoming></bpmn:endEvent>
<bpmn:sendTask id="t_erro" name="Registrar erro e manter arquivo anterior do MVP"><bpmn:incoming>f3</bpmn:incoming><bpmn:incoming>f8</bpmn:incoming><bpmn:incoming>f40</bpmn:incoming><bpmn:outgoing>f51</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="fim_falha" name="Falha"><bpmn:incoming>f51</bpmn:incoming></bpmn:endEvent>
